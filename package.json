import {createRequire} from "node:module";

import {coursePath} from "../../data/courses.js";
import {fullCourses as courses} from "./full-course-source.mjs";
import {learningPaths} from "../../data/learning-paths.js";
import {capstones} from "../../data/capstones.js";

const require = createRequire(import.meta.url);

const APPLY = process.argv.includes("--apply");
const PROJECT_ID = process.env.GCLOUD_PROJECT ||
  process.env.GOOGLE_CLOUD_PROJECT ||
  "cyberwithsandiso2";
const MIGRATED_AT = new Date();
const SAFE_DOCUMENT_BYTES = 900_000;

function withoutUndefined(value) {
  if (Array.isArray(value)) return value.map(withoutUndefined);
  if (!value || typeof value !== "object") return value;

  return Object.fromEntries(
      Object.entries(value)
          .filter(([, item]) => item !== undefined)
          .map(([key, item]) => [key, withoutUndefined(item)]),
  );
}

function lessonKeys(course) {
  return course.modules.flatMap((module) =>
    (module.lessons || []).map((lesson) => `${module.id}:${lesson.id}`),
  );
}

function activityKeys(course) {
  return course.modules.flatMap((module) =>
    [...(module.labActivities || []), ...(module.practiceActivities || [])]
        .map((activity) => `${module.id}:${activity.id}`),
  );
}

function assessmentKeys(course) {
  return course.modules
      .filter((module) => Array.isArray(module.moduleAssessment?.questions) &&
        module.moduleAssessment.questions.length)
      .map((module) => `${module.id}:assessment`);
}

function courseManifest(course) {
  const {modules, finalAssessment, ...metadata} = course;
  const path = coursePath[course.id] || {};

  return withoutUndefined({
    ...metadata,
    requiredPrerequisites: [...(path.required || [])],
    recommendedPrerequisites: [...(path.recommended || [])],
    moduleIds: modules.map((module) => module.id),
    requirements: {
      lessonKeys: lessonKeys(course),
      activityKeys: activityKeys(course),
      assessmentKeys: assessmentKeys(course),
      finalAssessmentRequired: Boolean(finalAssessment),
    },
    schemaVersion: 1,
    migratedAt: MIGRATED_AT,
  });
}

function moduleManifest(module) {
  const {
    lessons = [],
    labActivities = [],
    practiceActivities = [],
    moduleAssessment,
    ...metadata
  } = module;

  return withoutUndefined({
    ...metadata,
    lessonIds: lessons.map((lesson) => lesson.id),
    activityIds: [...labActivities, ...practiceActivities]
        .map((activity) => activity.id),
    lessonKeys: lessons.map((lesson) => `${module.id}:${lesson.id}`),
    activityKeys: [...labActivities, ...practiceActivities]
        .map((activity) => `${module.id}:${activity.id}`),
    hasAssessment: Array.isArray(moduleAssessment?.questions) &&
      moduleAssessment.questions.length > 0,
  });
}

const operations = [];
const put = (path, value) => {
  const cleanValue = withoutUndefined(value);
  const bytes = Buffer.byteLength(JSON.stringify(cleanValue));
  if (bytes > SAFE_DOCUMENT_BYTES) {
    throw new Error(
        `${path} is ${bytes} bytes. Split it before importing to Firestore.`,
    );
  }
  operations.push({path, value: cleanValue, bytes});
};

for (const course of Object.values(courses)) {
  put(`protectedCourses/${course.id}`, courseManifest(course));

  for (const module of course.modules || []) {
    const moduleRoot = `protectedCourses/${course.id}/modules/${module.id}`;
    put(moduleRoot, moduleManifest(module));

    for (const lesson of module.lessons || []) {
      put(`${moduleRoot}/lessons/${lesson.id}`, {
        ...lesson,
        courseId: course.id,
        moduleId: module.id,
      });
    }

    for (const activity of [
      ...(module.labActivities || []),
      ...(module.practiceActivities || []),
    ]) {
      put(`${moduleRoot}/activities/${activity.id}`, {
        ...activity,
        courseId: course.id,
        moduleId: module.id,
      });
    }

    if (module.moduleAssessment) {
      put(`${moduleRoot}/assessments/module`, {
        ...module.moduleAssessment,
        courseId: course.id,
        moduleId: module.id,
      });
    }
  }

  if (course.finalAssessment) {
    put(`protectedCourses/${course.id}/assessments/final`, {
      ...course.finalAssessment,
      courseId: course.id,
    });
  }
}

for (const path of Object.values(learningPaths)) {
  put(`protectedLearningPaths/${path.id}`, {
    ...path,
    schemaVersion: 1,
    migratedAt: MIGRATED_AT,
  });
}

for (const capstone of Object.values(capstones)) {
  put(`protectedCapstones/${capstone.id}`, {
    ...capstone,
    schemaVersion: 1,
    migratedAt: MIGRATED_AT,
  });
}

console.log(`Prepared ${operations.length} protected documents for ${PROJECT_ID}.`);
const largest = [...operations].sort((left, right) => right.bytes - left.bytes)[0];
console.log(`Largest document: ${largest.path} (${largest.bytes} bytes).`);

if (!APPLY) {
  const counts = operations.reduce((result, operation) => {
    const root = operation.path.split("/")[0];
    result[root] = (result[root] || 0) + 1;
    return result;
  }, {});
  console.table(counts);
  console.log("Dry-run only. Re-run with --apply after checking the project ID.");
  process.exit(0);
}

const {applicationDefault, getApps, initializeApp} = require("firebase-admin/app");
const {getFirestore} = require("firebase-admin/firestore");

if (!getApps().length) {
  initializeApp({credential: applicationDefault(), projectId: PROJECT_ID});
}

const db = getFirestore();
const writer = db.bulkWriter();

writer.onWriteError((error) => {
  console.error(`Write failed for ${error.documentRef.path}: ${error.message}`);
  return error.failedAttempts < 3;
});

for (const operation of operations) {
  writer.set(db.doc(operation.path), operation.value, {merge: false});
}

await writer.close();
console.log(`Imported ${operations.length} protected documents successfully.`);
